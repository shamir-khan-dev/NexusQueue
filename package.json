{
  "name": "nexusqueue",
  "version": "1.0.0",
  "description": "Enterprise-Grade Distributed Asynchronous Task & Workflow Engine with Zombie Task Recovery, Exponential Backoff, DLQ, and Real-Time Telemetry Dashboard",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "test:integration": "tsx --test tests/integration/**/*.test.ts",
    "benchmark": "tsx examples/benchmark.ts",
    "example:producer": "tsx examples/producer.ts",
    "example:worker": "tsx examples/worker.ts",
    "build": "tsc && node -e \"import('node:fs').then(fs => fs.cpSync('src/dashboard/public', 'dist/dashboard/public', {recursive: true}))\""
  },
  "keywords": [
    "task-queue",
    "distributed-systems",
    "worker-pool",
    "zombie-recovery",
    "at-least-once",
    "exponential-backoff",
    "rate-limiter",
    "dlq",
    "redis-streams",
    "telemetry"
  ],
  "author": "Shamir Khan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shamir-khan-dev/NexusQueue.git"
  },
  "bugs": {
    "url": "https://github.com/shamir-khan-dev/NexusQueue/issues"
  },
  "homepage": "https://github.com/shamir-khan-dev/NexusQueue#readme",
  "dependencies": {
    "cron-parser": "^4.9.0",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "prom-client": "^15.1.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
